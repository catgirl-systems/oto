{
  "soulseek": {
    "username": "",
    "password": "",
    "server": "server.slsknet.org:2242",
    "listen_addr": "0.0.0.0:50300",
    "network_interface": "",
    "connect_on_startup": true,
    "nat_pmp_port_mapping": true,
    "upnp_port_mapping": true
  },
  "search": {
    "remember_searches": true,
    "search_history_limit": 200,
    "remember_filters": true,
    "filter_history_limit": 50,
    "default_filter": "",
    "wishlist_interval_minutes": 15,
    "wishlist_notifications": true,
    "respond_to_incoming_searches": true,
    "minimum_incoming_search_length": 3,
    "maximum_incoming_search_results": 300
  },
  "bandwidth": {
    "active_profile": "Unlimited",
    "profiles": [
      {
        "name": "Unlimited",
        "upload_speed_limit_kib": 0,
        "download_speed_limit_kib": 0
      }
    ]
  },
  "uploads": {
    "max_queued_files_per_user": 0,
    "max_queued_bytes_per_user": 0,
    "auto_clear_completed": false,
    "limit_scope": "total",
    "scheduling": "fifo"
  },
  "downloads": {
    "filters_enabled": false,
    "filter_patterns": ["*.DS_Store", "*.exe", "*.msi", "desktop.ini", "Thumbs.db"],
    "auto_clear_completed": false,
    "after_file_command": "",
    "after_folder_command": "",
    "file_notifications": false,
    "folder_notifications": true
  },
  "statistics": {
    "log_retention_days": 0,
    "daily_retention_days": 0,
    "ascii_charts": false
  },
  "audio_metadata": true,
  "download_dir": "/downloads",
  "shares": [
    {
      "name": "Music",
      "path": "/shares/music"
    }
  ],
  "share_exclusions": [
    ".*",
    ".*/",
    "@eaDir/",
    "#recycle/",
    "#snapshot/",
    "desktop.ini",
    "Thumbs.db",
    "System Volume Information/",
    "$RECYCLE.BIN/",
    "lost+found/",
    "*.part",
    "*.partial",
    "*.crdownload",
    "*.tmp",
    "*.temp",
    "*.bak",
    "*~"
  ],
  "download_slots": 4,
  "upload_slots": 2
}
